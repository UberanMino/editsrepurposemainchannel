    },
    {
      "text": "I HAVE THREE ELBOWS AND A PLAN",
      "usageCount": 0,
      "lastUsedAt": null,
      "lastUsedInProject": null
    },
    {
      "text": "We elected a new sky last spring but nobody's really warmed up to it yet.",
